<!DOCTYPE html>
<html lang="en">
<head>    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anywhere Mechanic: My Booking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="css/shared.css" />
    <link rel="stylesheet" href="css/booking.css" />
</head>
<body>
    <div class="container">
        <div class="navbar">
            <a href="/" class="logo">ANYWHERE MECHANIC</a>
            <div class="right">
                <a href="/" class="link">HOME</a>
                <a href="my_booking.html" class="link">MY BOOKINGS</a>
                <a href="booking.html" class="link">BOOKINGS</a>
                <a href="garage.html" class="link">REGISTER GARAGE</a>
            </div>
            <div class="left">
                <div class="dropdown">
                    <a href="#" class="leftItems">
                        <div class="bi bi-bell"></div>
                    </a>
                    <div id="notifications" class="dropdown-content"></div>
                </div>
                <a id="admin" class="leftItems">
                    <div class="bi bi-person-fill-lock"></div>
                </a>
                <a href="account.html" class="leftItems">
                    <div class="bi bi-person-circle"></div>
                </a>
                <a id="logout" class="leftItems">
                    <div class="bi bi-box-arrow-right"></div>
                </a>
            </div>
        </div>
        <div class="content">
            <div class="legend">
                <legend>My Bookings:</legend>
                <div>
                    <button id="decrement_booking_offset">&lt;</button><input type="number" id="booking_offset"><button id="increment_booking_offset">&gt;</button> 
                    <select id="booking_limit">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select> / page
                </div>
            </div>
            <table id="table_booking" class="table_booking">
                <tr><th>Name</th><th>Garage Name</th><th>Address</th><th>Time</th><th>Delete</th></tr>
            </table>
        </div>
    </div>
    <script type="module" src="js/my_booking.js"></script>
</body>
</html>