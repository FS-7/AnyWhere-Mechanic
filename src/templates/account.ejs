<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anywhere Mechanic: Your account</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="css/shared.css" />
    <link rel="stylesheet" href="css/account.css" />
    <script>
        const HOST = '<%= HOST %>';
        const PORT = '<%= PORT %>'
    </script>
</head>
<body>
    <div class="container">
        <div class="navbar">
            <a href="/" class="logo">ANYWHERE MECHANIC</a>
            <div class="right">
                <a href="/" class="link">HOME</a>
                <a href="my_booking.html" class="link">MY BOOKINGS</a>
                <a href="booking.html" class="link">BOOKINGS</a>
                <a href="garage.html" class="link">REGISTER GARAGE</a>
            </div>
            <div class="left">
                <div class="dropdown">
                    <a href="#" class="leftItems">
                        <div class="bi bi-bell"></div>
                    </a>
                    <div id="notifications" class="dropdown-content"></div>
                </div>
                <a href="admin.html" class="leftItems">
                    <div class="bi bi-person-fill-lock"></div>
                </a>
                <a href="account.html" class="leftItems">
                    <div class="bi bi-person-circle"></div>
                </a>
                <a id="logout" class="leftItems">
                    <div class="bi bi-box-arrow-right"></div>
                </a>
            </div>
        </div>
        <div class="content">
            <table id="table_user" class="table_user">
                <legend>User Information:</legend>
                <tr><th></th><th>Current</th><th>Update</th></tr>
                <tr>
                    <td>First name: </td>
                    <td id="userfirstname"></td>
                    <td>
                        <form id="firstname_form" method="post"><input type="text" maxlength="32" name="firstname" required /><button class="success-btn" type="submit" ><p class="bi bi-check2"></p></button></form>
                    </td>
                </tr>
                <tr>
                    <td>Last name: </td>
                    <td id="userlastname"></td>
                    <td>
                        <form id="lastname_form" method="post"><input type="text" maxlength="32" name="lastname" required /><button class="success-btn" type="submit" ><p class="bi bi-check2"></p></button></form>
                    </td>
                </tr>
                <tr>
                    <td>Phone: </td>
                    <td id="userphone"></td>
                    <td>
                        <form id="phone_form" method="post"><input type="text" minlength="10" maxlength="10" name="phone" required /><button class="success-btn" type="submit" ><p class="bi bi-check2"></p></button></form>
                    </td>
                </tr>
                <tr>
                    <td>Email: </td>
                    <td id="useremail"></td>
                    <td>
                        <form id="email_form" method="post"><input type="email" name="email" required /><button class="success-btn" type="submit" ><p class="bi bi-check2"></p></button></form>
                    </td>
                </tr>
                <tr>
                    <td>Is Mechanic: </td>
                    <td id="mechanic"></td>
                </tr>
                
                <tr>
                    <td>Password: </td>
                    <td>**************</td>
                    <td>
                        <form id="update_password" class="form" method="post">
                            <div class="form-group">
                                <label for="old_password">Old Password: </label>
                                <input type="password" id="old_password" name="old_password" minlength="8" maxlength="32" required />
                            </div>
                            <div class="form-group">
                                <label for="password">New Password:</label>
                                <input type="password" id="password" name="password" minlength="8" maxlength="32" required />
                            </div>
                            <div class="form-group">
                                <label for="password2">New Password:</label>
                                <input type="password" id="password2" name="password2" minlength="8" maxlength="32" required />
                            </div>
                            <input type="submit" value="Update" class="submit"></input>
                        </form>
                    </td>
                </tr>
            </table>
            <br>
            <legend>Garage Information:</legend>
            <table id="table_garages" class="table_garages">
                
            </table>
        </div>
    </div>
    <script type="module" src="js/account.js"></script>
</body>
</html>