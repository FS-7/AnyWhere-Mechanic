<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anywhere Mechanic: Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="css/shared.css" />
    <link rel="stylesheet" href="css/admin.css" />
</head>

<body>
    <div class="container">
        <div class="navbar">
            <a href="/" class="logo">ANYWHERE MECHANIC</a>
            <div class="right">
                <a href="/" class="link">HOME</a>
                <a href="my_booking.html" class="link">MY BOOKINGS</a>
                <a href="booking.html" class="link">BOOKINGS</a>
                <a href="garage.html" class="link">REGISTER GARAGE</a>
            </div>
            <div class="left">
                <div class="dropdown">
                    <a href="#" class="leftItems">
                        <div class="bi bi-bell"></div>
                    </a>
                    <div id="notifications" class="dropdown-content"></div>
                </div>
                <a href="admin.html" class="leftItems">
                    <div class="bi bi-person-fill-lock"></div>
                </a>
                <a href="account.html" class="leftItems">
                    <div class="bi bi-person-circle"></div>
                </a>
                <a id="logout" class="leftItems">
                    <div class="bi bi-box-arrow-right"></div>
                </a>
            </div>
        </div>
        <div class="content">
            <div class="full_table">
                <div class="legend">
                    <legend>Users: </legend>
                    <div>
                        <button id="decrement_user_offset">&lt;</button><input type="number" id="user_offset" /><button id="increment_user_offset">&gt;</button> 
                        <select id="user_limit">
                            <option value="5" selected>5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                        </select> / page
                    </div>
                </div>
                <table id="users" class="table_users"></table>
            </div>
            <div class="full_table">
                <div class="legend">
                    <legend>Garages Information:</legend>
                    <div>
                        <button id="decrement_garage_offset">&lt;</button><input type="number" id="garage_offset"><button id="increment_garage_offset">&gt;</button> 
                        <select id="garage_limit">
                            <option value="5" selected>5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                        </select> / page
                    </div>
                </div>
                <table id="table_garages" class="table_garages"></table>
            </div>
            <div class="full_table">
                <div class="legend">
                    <legend>Bookings:</legend>
                    <div>
                        <button id="decrement_booking_offset">&lt;</button><input type="number" id="booking_offset"><button id="increment_booking_offset">&gt;</button> 
                        <select id="booking_limit">
                            <option value="5" selected>5</option>
                            <option value="10">10</option>
                            <option value="15">15</option>
                            <option value="20">20</option>
                        </select> / page
                    </div>
                </div>
                <table class="table_booking" id="table_booking" ></table>
            </div>
        </div>
    </div>
</body>
<script type="module" src="js/admin.js"></script>
</html>